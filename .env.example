# Copy this to .env and fill in values
# On Render, set these under the service's Environment tab
# (CORS_ORIGINS is not sensitive, a plain environment variable is fine)

# Comma-separated list of allowed frontend origins
# Local dev: leave empty (allows all) or set to http://localhost:5173
# Production: set to your Vercel URL e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# Enables GET /backtest, the model-evaluation tool.
# Local only, leave this UNSET in production. It retrains the model once per race,
# so an open endpoint in production is an easy way for anyone to stall the backend.
BACKTEST_ENABLED=true

# Weekend snapshots, see "Fantasy Predictor/Snapshots.md". On Render add these as SECRET values.
# SNAPSHOT_SECRET: any long random string. The lock GitHub Action sends it in the X-Snapshot-Secret
#   header, so it's also a repository secret on GitHub with the same value.
#   make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SNAPSHOT_SECRET=
# GITHUB_TOKEN: fine-grained token with Contents read and write on this repo only
GITHUB_TOKEN=
# optional, only if the repo or branch ever changes
GITHUB_REPO=pyyroo-a/Formula-1-Fantasy-Predictor
GITHUB_BRANCH=main
