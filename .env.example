# Copy this to .env and fill in values
# On Render, set these under the service's Environment tab
# (CORS_ORIGINS is not sensitive, a plain environment variable is fine)

# Comma-separated list of allowed frontend origins
# Local dev: leave empty (allows all) or set to http://localhost:5173
# Production: set to your Vercel URL e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# Enables GET /backtest, the model-evaluation tool.
# Local only — leave this UNSET in production. It retrains the model once per race,
# so an open endpoint in production is an easy way for anyone to stall the backend.
BACKTEST_ENABLED=true
